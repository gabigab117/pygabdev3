# Copy to .env and replace each value. No real value belongs here: the repository
# is public, and the CI copies this file as is to run its checks and tests.

DJANGO_SETTINGS_MODULE=project.settings.dev
SECRET_KEY=dev-only-not-a-secret-but-long-enough-to-sign-sessions
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP, with an app password, for production: development prints the
# emails in the console of runserver instead.
EMAIL_ID=contact@example.org
EMAIL_PW=not-a-real-app-password

# reCAPTCHA of the contact form.
RECAPTCHA_PUBLIC_KEY=not-a-real-public-key
RECAPTCHA_PRIVATE_KEY=not-a-real-private-key

# Admin paths: the real ones stay out of the repository.
DJANGO_ADMIN_URL=django-admin/
WAGTAIL_ADMIN_URL=admin/

# Production only.
DEBUG=False
DB_PASSWORD=not-a-real-password

# The password of the fictitious demo account (skill lancer-app), for local
# development only, never created on the server.
DEMO_PASSWORD=pygab-demo
